# ═══════════════════════════════════════════════════════════
# Doran AI Service - 환경변수 템플릿
# 복사 후 .env로 이름 변경하여 사용
# ═══════════════════════════════════════════════════════════

# ── 필수 ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=asia-northeast3

# ── 환경 설정 ─────────────────────────────────────────────
# development: /docs 활성화, /test 엔드포인트 허용
# production: /docs 비활성화, /test 차단
ENV=development

# ── Spring Boot 연동 ─────────────────────────────────────
SPRING_BOOT_BASE_URL=http://localhost:8080

# ── ChromaDB 저장 경로 ───────────────────────────────────
CHROMA_PERSIST_PATH=./data/chroma

# ── ChromaDB 텔레메트리 비활성화 ────────────────────────
# 활성화 시 import 단계에서 외부 서버로 HTTP 요청을 보내 서버 시작이 hang됨
ANONYMIZED_TELEMETRY=false

# ── 에피소드 콜백 설정 ───────────────────────────────────
CALLBACK_MAX_RETRIES=3
CALLBACK_BASE_DELAY=1.0
CALLBACK_MAX_DELAY=10.0
CALLBACK_TIMEOUT=10

# ── 기존 에피소드 조회 ───────────────────────────────────
FETCH_EPISODES_RETRIES=2
FETCH_EPISODES_TIMEOUT=5

# ── Circuit Breaker ──────────────────────────────────────
CB_FAIL_MAX=3
CB_RESET_TIMEOUT=30.0

# ── Outbox (파일 기반 Fallback) ─────────────────────────
OUTBOX_MAX_RETRIES=5
OUTBOX_BASE_DELAY=2.0
OUTBOX_MAX_DELAY=300.0

# ── 병렬 처리 ────────────────────────────────────────────
WRITER_MAX_WORKERS=5
MERGER_MAX_WORKERS=5

# ── 에피소드 재생성 기준 ─────────────────────────────────
REGEN_RICHNESS_THRESHOLD=0.50

# ── 에피소드 품질 가중치 (합계 = 1.0) ───────────────────
EQ_W_FAITHFULNESS=0.30
EQ_W_EMOTIONAL=0.25
EQ_W_COVERAGE=0.20
EQ_W_SENSORY=0.15
EQ_W_VOICE=0.07
EQ_W_FLOW=0.03

# ── 에피소드 품질 임계값 ─────────────────────────────────
EQ_T_RICH=0.85
EQ_T_GOOD=0.70
EQ_T_NORMAL=0.50
EQ_T_FAITH_MIN=0.70
EQ_T_RICH_MIN=0.50
